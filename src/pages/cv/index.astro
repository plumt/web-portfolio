---
import { careerYear } from "../../config";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Item from "../../components/Item.astro";
import SectionHead from "../../components/SectionHead.astro";
import { lemon, openit } from "../../data";
---

<BaseLayout title="Experience" sideBarActiveItemID="cv">
  <SectionHead num="01" title="경력" desc={`모바일 앱 개발자 · ${careerYear()}년차`} />

  <div class="company-head">
    <h3>{lemon.company}</h3>
    <span>{lemon.period} (재직 중)</span>
  </div>
  <div class="card-grid timeline">
    {lemon.items.map((i) => <Item current title={i.title} meta={i.meta} chips={i.chips} bullets={i.bullets ?? []}><p>{i.desc}</p></Item>)}
  </div>

  <div class="company-head">
    <h3>{openit.company}</h3>
    <span>{openit.period} ({openit.duration})</span>
  </div>
  <div class="card-grid timeline">
    {openit.items.map((i) => <Item title={i.title} meta={i.meta} chips={i.chips} url={`/cv/${i.slug}/`} target="_self"><p>{i.desc}</p></Item>)}
  </div>


  <section class="sec">
    <SectionHead num="02" title="기술" />
    <Item title="Mobile" chips={["Kotlin", "Jetpack Compose", "Kotlin Multiplatform", "Android", "React Native", "TypeScript"]} />
    <Item title="Architecture" chips={["Clean Architecture", "멀티 모듈", "MVVM", "Hilt", "Coroutine / Flow", "Room"]} />
    <Item title="Infra & AI" chips={["Firebase", "Jenkins", "Docker", "nginx", "Ollama", "AI 하네스"]} />
  </section>
</BaseLayout>

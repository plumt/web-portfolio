---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { careers } from "../../careers";

export function getStaticPaths() {
  return careers.map((c) => ({ params: { slug: c.slug }, props: { c } }));
}

const { c } = Astro.props;
const all = import.meta.glob("../../assets/projects/*/*.{jpg,jpeg,png,webp}", { eager: true, query: "?url", import: "default" });
const logos = import.meta.glob("../../assets/logos/*.png", { eager: true, query: "?url", import: "default" });
const logo = Object.entries(logos).find(([path]) => path.endsWith(`/logos/${c.slug}.png`))?.[1] as string | undefined;
const shots = Object.entries(all)
  .filter(([path]) => path.includes(`/projects/${c.slug}/`))
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, url]) => url as string);
---

<BaseLayout title={c.title} sideBarActiveItemID="cv">
  <a class="detail-back" href="/cv/">← Experience</a>
  <h1 class="sec-title detail-title">{logo && <img class="detail-logo" src={logo} alt="" />}<span>{c.title}</span></h1>
  <p class="detail-meta">오픈잇 · {c.period}{c.note ? ` · ${c.note}` : ""} · {c.team}</p>

  <section class="detail-sec">
    <h2>개요</h2>
    <p>{c.overview}</p>
    {c.links && <p class="detail-links">{c.links.map((l) => <a href={l.url} target="_blank" rel="noopener noreferrer">{l.label} ↗</a>)}</p>}
  </section>

  <section class="detail-sec">
    <h2>담당 역할</h2>
    <ul>{c.role.map((r) => <li>{r}</li>)}</ul>
  </section>

  <section class="detail-sec">
    <h2>기술 스택</h2>
    <dl>{c.stack.map(([k, v]) => <div class="stack-row"><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
  </section>

  {c.env.length > 0 && (
    <section class="detail-sec">
      <h2>개발 환경</h2>
      <dl>{c.env.map(([k, v]) => <div class="stack-row"><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
    </section>
  )}

  {shots.length > 0 && (
    <section class="detail-sec">
      <h2>스크린샷</h2>
      <div class="shots">{shots.map((s, n) => <img src={s} alt={`${c.title} 화면 ${n + 1}`} loading="lazy" />)}</div>
    </section>
  )}
</BaseLayout>

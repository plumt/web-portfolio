---
import BaseLayout from "../layouts/BaseLayout.astro";
import Item from "../components/Item.astro";
import SectionHead from "../components/SectionHead.astro";
import { PROFILE } from "../config";
import { apps, firebase } from "../data";
---

<BaseLayout title="My Apps" sideBarActiveItemID="projects">
  <SectionHead num="01" title="만든 앱" desc="Kotlin과 Jetpack Compose로 만든 Android 앱 7개. 아직 출시 전이고, 하나씩 다듬어 가고 있습니다." />

  <div class="card-grid">
    {apps.map((a, n) => (
      <Item title={a.name} url={a.url} chips={a.chips} icon={a.name[0]} image={a.image} tone={n % 6}><p>{a.desc}</p></Item>
    ))}
  </div>

  <section class="sec">
    <SectionHead num="02" title="모듈 구조" desc="Clean Architecture와 모듈 구조로 Gradle 모듈 135개를 운영합니다." />
    <Item title="빌드가 지키는 설계" url={`${PROFILE.docsRepo}/blob/main/ARCHITECTURE.md`}>
      <ul>
        <li>의존 방향(apps → shared/feature → shared/core)을 문서가 아니라 빌드(Convention Plugin의 Guard)가 강제</li>
        <li>출시 후에야 드러나는 오류(빈 키, 테스트 광고 ID, 서명 누락)를 빌드 전에 차단</li>
        <li>API 키 같은 런타임 값은 NDK로 숨김</li>
      </ul>
    </Item>
  </section>

  <section class="sec">
    <SectionHead num="03" title="Firebase로 구성한 서비스" desc="앱 개발자로서 백엔드와 프론트를 Firebase로 구성했습니다. 서비스 준비 단계입니다." />
    <div class="card-grid">
      {firebase.map((f) => <Item title={f.title}><p>{f.desc}</p></Item>)}
    </div>
  </section>
</BaseLayout>

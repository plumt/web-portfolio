---
import BaseLayout from "../layouts/BaseLayout.astro";
import Item from "../components/Item.astro";
import SectionHead from "../components/SectionHead.astro";
import { infra, automations } from "../data";
---

<BaseLayout title="Infra & AI" sideBarActiveItemID="lab">
  <SectionHead num="01" title="자동화 프로세스" desc="빌드와 배포부터 크래시 대응까지, 반복되는 개발 과정을 자동화합니다." />
  <div class="card-grid">
    {automations.map((a) => (
      <Item title={a.title} meta={a.wip ? "개발 중" : "운영 중"}><p>{a.desc}</p></Item>
    ))}
  </div>

  <section class="sec">
    <SectionHead num="02" title="만들고 운영하는 것" desc="업무 밖에서 구성하고 운영하는 개발 환경과 AI 자동화입니다." />
    <div class="card-grid">
      {infra.map((i) => (
        <Item title={i.title} meta={i.meta} chips={i.chips} bullets={i.bullets ?? []}>{i.desc && <p>{i.desc}</p>}</Item>
      ))}
    </div>
  </section>
</BaseLayout>

---
// 빌드 시각을 한국 시간 날짜로 표시한다 (배포할 때마다 갱신)
const parts = new Intl.DateTimeFormat("ko-KR", { timeZone: "Asia/Seoul", year: "numeric", month: "2-digit", day: "2-digit" }).formatToParts(new Date());
const pick = (t: string) => parts.find((p) => p.type === t)?.value;
const updated = `${pick("year")}.${pick("month")}.${pick("day")}`;
---
<div
    class="block sticky pointer-events-none bottom-10 bg-base-200 justify-center h-12 [mask-image:linear-gradient(transparent,#000000)]"
>
</div>

<div class="px-4 pb-5 pt-1 flex self-center justify-center sticky bottom-0 bg-base-200 text-xs opacity-60">
    Last updated {updated}
</div>
